# Database Connection Strings
READER_DSN=postgresql://twin_reader:reader_password@localhost:5432/twin
WRITER_DSN=postgresql://twin_writer:writer_password@localhost:5432/twin
ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/twin

# MCP Configuration
MCP_TRANSPORT=stdio
MCP_PORT=8000
CLIENT_ID=200
DEFAULT_LEDGER=0L

# Pagination Defaults
ROW_LIMIT_DEFAULT=50
ROW_LIMIT_MAX=200

# Approval Mode: auto (eval harness automatically approves pending drafts) | manual
APPROVAL_MODE=auto

# Agent Runtime Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
